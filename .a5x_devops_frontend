a5x_devops:
  build:
    stack: "node"
    stack_version: "20"
    working-directory: "./app"
  deploy:
    ecs:
      task_definition_file: "infra/ecs/task-definition-dev.json"
      service_name: "template-infra-app-service"
      cluster_name: "template-infra-app-cluster"
      container_name: "template_infra_app"
    eks:
      namespace: "template-infra-app-namespace"
      manifests_folder: "infra/k8s"
      helm_chart_folder: "infra/charts"
    dev:
      account_id: "123456789012"
      region: "us-east-1"
      task_definition_file: "infra/ecs/task-definition-dev.json"
    cer:
      account_id: "210987654321"
      region: "us-west-2"
      task_definition_file: "infra/ecs/task-definition-cer.json"
    prd:
      account_id: "345678901234"
      region: "eu-central-1"
      task_definition_file: "infra/ecs/task-definition-prd.json"
