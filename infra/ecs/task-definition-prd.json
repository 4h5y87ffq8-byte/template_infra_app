{
    "family": "template-infra-app-prd",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "arn:aws:iam::345678901234:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::345678901234:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "template_infra_app",
            "image": "345678901234.dkr.ecr.eu-central-1.amazonaws.com/template_infra_app:latest",
            "portMappings": [
                {
                    "containerPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/template-infra-app-prd",
                    "awslogs-region": "eu-central-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "environment": [
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "prd"
                },
                {
                    "name": "ENV",
                    "value": "production"
                }
            ],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -f http://localhost:8080/actuator/health || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            }
        }
    ]
}