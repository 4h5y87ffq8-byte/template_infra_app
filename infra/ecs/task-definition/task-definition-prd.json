[
  {
    "name": "${container_name}",
    "image": "${container_image}",
    "essential": true,
    "portMappings": [
      {
        "containerPort": ${container_port},
        "protocol": "tcp"
      }
    ],
    "environment": [
      {
        "name": "ENVIRONMENT",
        "value": "prd"
      },
      {
        "name": "AWS_REGION",
        "value": "${aws_region}"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/template-infra-app-service/prd",
        "awslogs-region": "${aws_region}",
        "awslogs-stream-prefix": "prd"
      }
    },
    "healthCheck": {
      "command": ["CMD-SHELL", "curl -f http://localhost:${container_port}/health || exit 1"],
      "interval": 20,
      "timeout": 3,
      "retries": 5,
      "startPeriod": 90
    }
  }
]
